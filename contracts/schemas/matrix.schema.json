{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "matrix.schema.json",
  "title": "matrix.json: site x landing-date grid for the main heatmap",
  "description": "Cell [i][j] = metrics for site_ids[i] landing at landing_dates_utc[j], computed over [landing, landing + mission_duration_h]. Answers 'the launch slipped two weeks, what now?'",
  "allOf": [{ "$ref": "common.schema.json#/$defs/header" }],
  "type": "object",
  "required": ["site_ids", "landing_dates_utc", "mission_duration_h", "sun_threshold_frac", "cells"],
  "properties": {
    "contract_version": true, "generated_at": true, "source": true,
    "site_ids": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/id" } },
    "landing_dates_utc": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/time_utc" } },
    "mission_duration_h": { "type": "number", "exclusiveMinimum": 0 },
    "sun_threshold_frac": { "$ref": "common.schema.json#/$defs/frac" },
    "cells": {
      "type": "object",
      "description": "Each field is a 2D array [site][date]. null = not computed.",
      "required": ["sunlit_frac", "earth_visible_frac", "both_frac", "longest_dark_h"],
      "properties": {
        "sunlit_frac": { "$ref": "#/$defs/grid" },
        "earth_visible_frac": { "$ref": "#/$defs/grid" },
        "both_frac": { "$ref": "#/$defs/grid" },
        "longest_dark_h": { "$ref": "#/$defs/grid" },
        "longest_no_earth_h": { "$ref": "#/$defs/grid" }
      },
      "additionalProperties": { "$ref": "#/$defs/grid" }
    },
    "uncertainty_notes": { "type": "string", "description": "how uncertain the cell values are (one statement for the whole grid in v0.1)" }
  },
  "additionalProperties": false,
  "$defs": {
    "grid": { "type": "array", "items": { "type": "array", "items": { "type": ["number", "null"] } } }
  }
}
