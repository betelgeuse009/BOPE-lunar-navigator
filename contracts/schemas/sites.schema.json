{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sites.schema.json",
  "title": "sites.json: curated landing-site list",
  "allOf": [{ "$ref": "common.schema.json#/$defs/header" }],
  "type": "object",
  "required": ["sites"],
  "properties": {
    "contract_version": true, "generated_at": true, "source": true,
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "lat_deg", "lon_deg", "category", "coord_source"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "lat_deg": { "type": "number", "minimum": -90, "maximum": 90, "description": "selenographic latitude (Mean Earth/Polar Axis frame)" },
          "lon_deg": { "type": "number", "minimum": -180, "maximum": 180, "description": "selenographic longitude, east positive" },
          "category": { "type": "string", "enum": ["apollo", "clps", "artemis", "international", "commercial", "other"] },
          "coord_source": { "type": "string", "description": "citation for the coordinates (paper, NASA page, etc.)" },
          "description": { "type": "string", "description": "one or two sentences for the public/educator view" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
